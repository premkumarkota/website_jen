<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="C:\Program Files (x86)\nodejs\20.20.0\node.exe" arguments="server.js" stdoutLogEnabled="true" stdoutLogFile="\\?\%home%\LogFiles\stdout" startupTimeLimit="120" processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%"/>
        <environmentVariable name="NODE_ENV" value="production"/>
        <environmentVariable name="HOSTNAME" value="0.0.0.0"/>
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
